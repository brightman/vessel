{
  "compilerOptions": {
    "paths": { "@/*": ["./apps/web/src/*"] },
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["apps/web/**/*.ts", "apps/web/**/*.tsx"]
}
