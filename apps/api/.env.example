NOTES_ENVIRONMENT=development
NOTES_DATABASE_URL=postgresql+psycopg://vessel@127.0.0.1:55432/vessel_dev
NOTES_ISSUER_URL=http://127.0.0.1:52003
NOTES_ALLOW_REGISTRATION=false
NOTES_ACCESS_TOKEN_TTL_SECONDS=900
NOTES_REFRESH_TOKEN_TTL_SECONDS=2592000
NOTES_NOTE_CAPABILITY_TTL_SECONDS=86400
NOTES_ASSET_STORAGE_PATH=var/vessel-assets
NOTES_APP_RELEASE_STORAGE_PATH=var/app-releases
# Release-zone base origin. Each App runs on {app_id}.apps.127.0.0.1.nip.io; production requires HTTPS and wildcard DNS/TLS.
NOTES_APP_RELEASE_ORIGIN=http://apps.127.0.0.1.nip.io:52003
# Required in production; use a long random value outside version control.
NOTES_H5_PREVIEW_SECRET=replace-in-production
NOTES_MAX_ASSET_UPLOAD_BYTES=5242880
NOTES_REFRESH_COOKIE_SECURE=false
NOTES_AGENT_PLATFORM_URL=https://agent.lobs.cc
NOTES_AGENT_ID=agent_50c3d52c855c4adcb4231f34412c0eca
# Configure these on Vessel after provisioning the matching trusted gateway identity on Agent ECS.
# NOTES_AGENT_GATEWAY_USER_ID=
# NOTES_AGENT_GATEWAY_SECRET=

# Registration email verification. Put secrets in the ignored apps/api/.env,
# or select another env file with NOTES_CONFIG_FILE.
REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
REGISTRATION_EMAIL_DAILY_LIMIT=300
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@karama.cloud
BREVO_SENDER_NAME=Karama
BREVO_TIMEOUT_SECONDS=10
# Set a stable random secret of at least 32 characters in the local secret file.
# REGISTRATION_CODE_SECRET=
