PAGES_ENVIRONMENT=development
PAGES_DATABASE_URL=postgresql+psycopg://vessel@127.0.0.1:55432/vessel_dev
PAGES_ISSUER_URL=http://127.0.0.1:52003
PAGES_ALLOW_REGISTRATION=false
PAGES_ACCESS_TOKEN_TTL_SECONDS=900
PAGES_REFRESH_TOKEN_TTL_SECONDS=2592000
PAGES_PAGE_CAPABILITY_TTL_SECONDS=86400
PAGES_ASSET_STORAGE_PATH=var/vessel-assets
PAGES_APP_RELEASE_STORAGE_PATH=var/app-releases
# Release-zone base origin. Each App runs on {app_id}.apps.127.0.0.1.nip.io; production requires HTTPS and wildcard DNS/TLS.
PAGES_APP_RELEASE_ORIGIN=http://apps.127.0.0.1.nip.io:52003
# Required in production; use a long random value outside version control.
PAGES_H5_PREVIEW_SECRET=replace-in-production
PAGES_MAX_ASSET_UPLOAD_BYTES=5242880
PAGES_REFRESH_COOKIE_SECURE=false

# Registration verification. Startup also loads apps/api/.env.brevo or
# PAGES_BREVO_CONFIG_FILE; process environment values take precedence.
PAGES_REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
PAGES_REGISTRATION_EMAIL_DAILY_LIMIT=300
PAGES_BREVO_API_KEY=
PAGES_BREVO_SENDER_EMAIL=hello@karama.cloud
PAGES_BREVO_SENDER_NAME='Memory on Cloud'
PAGES_BREVO_TIMEOUT_SECONDS=10
# Set a stable random secret of at least 32 characters in the local secret file.
# PAGES_REGISTRATION_CODE_SECRET=
