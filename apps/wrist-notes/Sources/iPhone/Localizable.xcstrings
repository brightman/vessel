        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録時の場所のみです。連続した経路や滞在時間を示すものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只展示记录时的地点，不代表连续行程或停留时长。"
          }
        }
      }
    },
    "只录你一个人讲话": {
      "localizations": {
        "en": {
          "stringUnit": {
