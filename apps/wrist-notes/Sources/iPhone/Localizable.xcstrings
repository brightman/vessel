        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no need to fill tomorrow. Start with one small step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の予定を埋め尽くす必要はありません。小さな一歩から始めましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不必排满明天。采纳一条建议，就从一件小事开始。"
          }
        }
